# ─────────────────────────────────────────────────────────────
#  বঙ্গবন্ধু ও বাংলাদেশ — environment
#  Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for OG tags, links, CSRF origin checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────
# Local (docker compose):
DATABASE_URL="postgresql://archive:archive@localhost:5432/archive?schema=public"
DIRECT_URL="postgresql://archive:archive@localhost:5432/archive?schema=public"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Object storage ───────────────────────────────────────────
# "local" = files under ./.data/storage (dev only, no setup needed)
# "s3"    = any S3-compatible store: Cloudflare R2, MinIO, AWS S3, Supabase Storage (S3 API)
STORAGE_DRIVER="local"
S3_BUCKET="archive"
S3_REGION="auto"
# MinIO (docker compose):   http://localhost:9000
# Cloudflare R2:            https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# true for MinIO, false for R2 / AWS
S3_FORCE_PATH_STYLE="false"
# Only for trying `npm start` locally without S3. Never on Vercel.
ALLOW_LOCAL_STORAGE="false"

# ── Secrets (generate each with: openssl rand -base64 32) ────
# Auth.js session signing
AUTH_SECRET="change-me"
# Salt for hashed rate-limit keys (IP addresses are never stored)
RATE_LIMIT_SALT="change-me"
# 32-byte key (base64) for encrypting contact details / victim names at rest
ENCRYPTION_KEY="change-me-32-bytes-base64"
# Signs local-driver upload URLs
UPLOAD_SIGNING_SECRET="change-me"

# Auth.js: trust the host header (needed behind Vercel / proxies)
AUTH_TRUST_HOST="true"
# Non-Vercel deployments only: a header overwritten by a trusted reverse proxy.
# Leave empty unless direct access to the origin is blocked. Vercel needs no override.
TRUSTED_PROXY_IP_HEADER=""

# ── Cloudflare Turnstile (captcha) ───────────────────────────
# These are Cloudflare's official always-pass TEST keys. Replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Set to "true" only for local development without network access
CAPTCHA_DISABLED="false"

# ── Admin login code by email (second step after the password) ─
# Set RESEND_API_KEY (resend.com → API Keys) to turn it ON for every admin account.
# While on, each login needs the password AND a 6-digit code sent to the admin's own email
# (valid 10 minutes, 5 tries, single use). Leave empty to log in with the password only.
# Keep it empty on the database used by `npm run test:security`.
RESEND_API_KEY=""
# Sender; must be an address on a domain verified in Resend. onboarding@resend.dev only
# delivers to the Resend account owner's own email (fine for a first test).
OTP_EMAIL_FROM="Archive Security <onboarding@resend.dev>"

# ── First admin (used by `npm run admin:create` and the seed) ─
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Admin"

# Secret admin address: the panel is served at /<ADMIN_PATH>, and /admin answers 404.
# 8-100 letters/digits/-/_. Set it only in the hosting environment (the repo is public).
# Leave empty to keep the panel at /admin.
ADMIN_PATH=""
