{
  "name": "bongobondhu-archive",
  "version": "1.0.0",
  "private": true,
  "description": "বঙ্গবন্ধু ও বাংলাদেশ — national digital archive (Next.js + PostgreSQL + S3/R2)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:app-role": "tsx scripts/create-app-role.ts",
    "images:import": "tsx scripts/import-images.ts",
    "postinstall": "prisma generate",
    "cleanup": "tsx scripts/cleanup.ts",
    "lighthouse": "npx lighthouse http://localhost:3000 --form-factor=mobile --view",
    "test:validation": "tsx scripts/validation-test.ts",
    "test:security": "node scripts/security-test.mjs",
    "test:security:unit": "node scripts/security-unit-test.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.2",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
